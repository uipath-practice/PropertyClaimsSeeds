{
  "$schema": "https://cloud.uipath.com/draft/2024-12/entry-point",
  "$id": "entry-points.json",
  "entryPoints": [
    {
      "filePath": "/content/agent.json",
      "uniqueId": "f069b3bc-501d-4ed4-89a1-b93eb6064e1b",
      "type": "agent",
      "input": {
        "type": "object",
        "required": [
          "in_PolicyID",
          "in_ClaimIXPDataJSON",
          "in_PolicyPDF"
        ],
        "properties": {
          "in_PolicyID": {
            "type": "string",
            "description": "ID of the insurance policy as mentioned on FNOL form"
          },
          "in_ClaimIXPDataJSON": {
            "type": "object",
            "description": "Claim Information Containing all the details after document extraction",
            "properties": {}
          },
          "in_PolicyPDF": {
            "description": "File containing insurance policy associated with the Claim",
            "$ref": "#/definitions/job-attachment",
            "definitions": {
              "job-attachment": {
                "type": "object",
                "properties": {
                  "ID": {
                    "type": "string",
                    "description": "Orchestrator attachment key"
                  },
                  "FullName": {
                    "type": "string",
                    "description": "File name"
                  },
                  "MimeType": {
                    "type": "string",
                    "description": "The MIME type of the content, such as \"application/json\" or \"image/png\""
                  },
                  "Metadata": {
                    "type": "object",
                    "description": "Dictionary<string, string> of metadata",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ID"
                ],
                "x-uipath-resource-kind": "JobAttachment"
              }
            }
          }
        },
        "definitions": {
          "job-attachment": {
            "type": "object",
            "required": [
              "ID"
            ],
            "x-uipath-resource-kind": "JobAttachment",
            "properties": {
              "ID": {
                "type": "string",
                "description": "Orchestrator attachment key"
              },
              "FullName": {
                "type": "string",
                "description": "File name"
              },
              "MimeType": {
                "type": "string",
                "description": "The MIME type of the content, such as \"application/json\" or \"image/png\""
              },
              "Metadata": {
                "type": "object",
                "description": "Dictionary<string, string> of metadata",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "out_isEligible",
          "out_EligibilityChecksJSON",
          "out_ClaimDataJSON",
          "out_isComplete",
          "out_PolicyDataJSON"
        ],
        "properties": {
          "out_isEligible": {
            "type": "boolean",
            "description": "Whether Claim is eligible for assessment or not"
          },
          "out_isComplete": {
            "type": "boolean",
            "description": "Whether property claim has all required information."
          },
          "out_EligibilityChecksJSON": {
            "type": "object",
            "description": "The eligibility check envelope. Every string in it is shown to a human reviewer, so labels must be human-readable, never payload field names. See contracts/check-envelope.md.",
            "required": [
              "verdict",
              "headline",
              "summary",
              "checks"
            ],
            "properties": {
              "verdict": {
                "type": "string",
                "description": "pass when all five checks pass; fail when the claim cannot proceed; attention when a human should decide.",
                "enum": [
                  "pass",
                  "attention",
                  "fail"
                ]
              },
              "headline": {
                "type": "string",
                "description": "One line the reviewer can act on. States the reason, not the outcome."
              },
              "summary": {
                "type": "string",
                "description": "Reasoning across all five checks. Replaces the former out_EligibilityAnalysisSummary output."
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checks": {
                "type": "array",
                "description": "Exactly the five eligibility checks, in order, reported whether they pass or fail.",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "status",
                    "verdict"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "policy_status",
                        "identity_match",
                        "address_match",
                        "coverage_period",
                        "filing_deadline"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "description": "Sentence case, written for a claims reviewer."
                    },
                    "status": {
                      "type": "string",
                      "description": "warn when satisfied only with a caveat, e.g. a late filing with a stated justification.",
                      "enum": [
                        "pass",
                        "warn",
                        "fail"
                      ]
                    },
                    "verdict": {
                      "type": "string",
                      "description": "The one-line result shown beside the label."
                    },
                    "details": {
                      "type": "array",
                      "description": "Supporting evidence for this check, up to 6 rows. Supply it for every check, passing ones included — a reviewer can expand a passing check to see what was compared.",
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "value"
                        ],
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "out_ClaimDataJSON": {
            "type": "object",
            "description": "Cleaned claim data without extraction metadata. Keeps every field for downstream analysis; the typed facts a database column needs are separate scalar outputs.",
            "properties": {}
          },
          "out_PolicyDataJSON": {
            "type": "object",
            "description": "Policy Data converted from PDF to JSON. Keep every field and every clause from Policy file for downstream analysis.",
            "properties": {}
          },
          "out_ClaimantName": {
            "type": "string",
            "description": "Claimant name. Own column, so plain text — no titles or annotations."
          },
          "out_PropertyCountry": {
            "type": "string",
            "description": "Country of the insured property."
          },
          "out_IncidentType": {
            "type": "string",
            "description": "Incident type, e.g. Water damage."
          },
          "out_IncidentDate": {
            "type": "string",
            "description": "ISO 8601 date, e.g. 2026-03-14. Not DD/MM/YYYY."
          },
          "out_DateOfSubmission": {
            "type": "string",
            "description": "ISO 8601 date the claim was submitted."
          },
          "out_TotalClaimAmount": {
            "type": "number",
            "description": "A number, not a formatted currency string. Strip the symbol and thousands separator."
          },
          "out_Currency": {
            "type": "string",
            "description": "ISO 4217 code, e.g. HKD."
          }
        }
      }
    }
  ]
}
